{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "ngx-restangular-demo": {
      "projectType": "application",
      "root": "demo",
      "sourceRoot": "demo",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/demo",
            "index": "demo/index.html",
            "browser": "demo/main.ts",
            "tsConfig": "demo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "demo/public"
              },
              "demo/favicon.ico"
            ],
            "styles": [
              "demo/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "demo/environments/environment.ts",
                  "with": "demo/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ngx-restangular-demo:build:production"
            },
            "development": {
              "buildTarget": "ngx-restangular-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "ngx-restangular": {
      "projectType": "library",
      "root": "projects/ngx-restangular",
      "sourceRoot": "projects/ngx-restangular/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ngx-restangular/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-restangular/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-restangular/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-restangular/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
